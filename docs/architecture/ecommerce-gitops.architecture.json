  "cards": [
    {
      "dot": "cyan",
      "title": "GitLab CI 门禁",
      "items": [
        "MR 和 branch push 触发；tag 不在 GitLab 建发布流水线。",
        "context-gate、文档同步、环境检查、public IP、canary、gitleaks、backend-gate、frontend-gate。",
        "只验证代码与文档，不推送镜像、不修改部署清单。"
      ]
    },
    {
      "dot": "emerald",
      "title": "GitHub Actions 发布",
      "items": [
        "semver tag `X.Y.Z` 触发服务检测和矩阵构建。",
        "Dockerfile 进入 Buildx 多架构构建；执行 Trivy、SBOM、Cosign keyless 签名。",
        "制品推到 TCR，GHCR 可选；Helm 制品进入 Harbor OCI。"
      ]
    },
    {
      "dot": "amber",
      "title": "清单回写与晋级",
      "items": [
        "`promote-release.py` 同步更新 Helm values 与 raw deployment manifests。",
        "`verify-deploy-parity.sh` 在提交前验证两份部署真相源等价。",
        "回写 GitHub main，并同步 GitLab main；ArgoCD 使用 GitLab main。"
      ]
    },
    {
      "dot": "violet",
      "title": "ArgoCD 与集群",
      "items": [
        "ArgoCD 通过 Application/ApplicationSet 拉取 GitLab desired state。",
        "sync、prune、selfHeal 进入 Kubernetes；当前业务接管状态仍需按环境核对。",
        "回滚语义为 revert，不以生产环境手工 kubectl 修改作为发布路径。"
      ]
    }
  ]
}
