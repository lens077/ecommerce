liseconds_bucket{service_name!=\"config-service\",service_name=\"$service\"}[$__rate_interval])))", "legendFormat": "P99"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "ms", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 10, "type": "timeseries", "title": "P95 by 方法", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate(rpc_server_duration_milliseconds_bucket{service_name!=\"config-service\",service_name=\"$service\"}[$__rate_interval])))", "legendFormat": "{{rpc_method}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "ms", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 11, "type": "row", "title": "[$service] 错误分析 —— 服务侧错误进 SLO,客户端异常只观察", "gridPos": {"x": 0, "y": 24, "w": 24, "h": 1}, "collapsed": false}, {"id": 12, "type": "timeseries", "title": "服务侧错误 by 方法+错误码", "description": "健康时这张图为空是正常的(错误序列只在出错后才存在)。\nunknown = 未包装的普通 error(CodeOf(nil) 语义);panic 被 recover 后是 internal", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 25, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (rpc_method, rpc_connect_rpc_error_code) (rate(rpc_server_duration_milliseconds_count{service_name=\"$service\",rpc_connect_rpc_error_code=~\"unknown|internal|unavailable|deadline_exceeded|resource_exhausted|data_loss|unimplemented\"}[$__rate_interval]))", "legendFormat": "{{rpc_method}} {{rpc_connect_rpc_error_code}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 13, "type": "timeseries", "title": "服务侧错误率(整服务)", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 25, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "(sum by (service_name) (rate(rpc_server_duration_milliseconds_count{rpc_connect_rpc_error_code=~\"unknown|internal|unavailable|deadline_exceeded|resource_exhausted|data_loss|unimplemented\",service_name!=\"config-service\",service_name=\"$service\"}[$__rate_interval])) or sum by (service_name) (rate(rpc_server_duration_milliseconds_count{service_name!=\"config-service\",service_name=\"$service\"}[$__rate_interval])) * 0) / sum by (service_name) (rate(rpc_server_duration_milliseconds_count{service_name!=\"config-service\",service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "错误率"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}}, "overrides": []}}, {"id": 14, "type": "timeseries", "title": "客户端异常 by 错误码(不进 SLO)", "description": "invalid_argument 突增 = 前端契约破坏或恶意流量;unauthenticated 突增 = 鉴权链路问题。\n都不算服务的错,但值得看见", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 25, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (rpc_method, rpc_connect_rpc_error_code) (rate(rpc_server_duration_milliseconds_count{service_name=\"$service\",rpc_connect_rpc_error_code=~\"invalid_argument|not_found|already_exists|permission_denied|unauthenticated|failed_precondition|out_of_range|canceled|aborted\"}[$__rate_interval]))", "legendFormat": "{{rpc_method}} {{rpc_connect_rpc_error_code}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 15, "type": "row", "title": "[$service] Go runtime —— P1:等 runtime 埋点发版;对标 ARMS 的 JVM/FullGC 区", "gridPos": {"x": 0, "y": 33, "w": 24, "h": 1}, "collapsed": false}, {"id": 16, "type": "timeseries", "title": "goroutine 数", "description": "Go 服务最重要的单一健康指标(OBSERVABILITY.md §3.2)。\n持续增长 = 泄漏/Channel 阻塞,对照最近发版", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 34, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "go_goroutine_count{service_name=\"$service\"}", "legendFormat": "goroutines"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 17, "type": "timeseries", "title": "堆内存 vs GC 目标", "description": "used 贴着 goal = GC 频繁;贴着 limit = 快 OOM", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 6, "y": 34, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "go_memory_used_bytes{service_name=\"$service\"}", "legendFormat": "used"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "go_memory_gc_goal_bytes{service_name=\"$service\"}", "legendFormat": "gc goal"}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "go_memory_limit_bytes{service_name=\"$service\"}", "legendFormat": "gomemlimit"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 18, "type": "timeseries", "title": "堆分配速率", "description": "分配速率陡增 → GC 压力的源头,先于延迟恶化出现", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 12, "y": 34, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "rate(go_memory_allocated_bytes_total{service_name=\"$service\"}[$__rate_interval])", "legendFormat": "alloc/s"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 19, "type": "timeseries", "title": "调度延迟 P99(GC 暂停的替代信号)", "description": "goroutine 就绪→实际运行的等待。runtime v0.70 没有 GC pause 指标,\nGC STW 和 CPU 饱和都会先在这里冒头(接口变慢不一定是 DB —— 先排除这里)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 18, "y": 34, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(go_schedule_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))", "legendFormat": "P99"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 20, "type": "row", "title": "[$service] DB(PostgreSQL)—— acquire 慢是池不够,query 慢是 SQL 的事", "gridPos": {"x": 0, "y": 42, "w": 24, "h": 1}, "collapsed": false}, {"id": 21, "type": "timeseries", "title": "连接池饱和度与等待", "description": "「很多故障不是数据库挂了,是池子满了」—— 空池等待一出现就是真信号,\n饱和度贴 90% 可能只是稳态", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 43, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "pgxpool_acquired_connections{service_name=\"$service\"} / pgxpool_max_connections{service_name=\"$service\"}", "legendFormat": "饱和度"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum (rate(pgxpool_empty_acquire_total{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "空池等待 次/s"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 22, "type": "timeseries", "title": "DB 操作 P95(分类型)", "description": "必须带 db_system_name 过滤:redisotel 上线后同名指标里混着 Redis 的微秒级样本,\n裸聚合会画出一条假「优化」(面板设计.md §1.5)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 43, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.95, sum by (le, pgx_operation_type) (rate(db_client_operation_duration_seconds_bucket{service_name=\"$service\",db_system_name=\"postgresql\"}[$__rate_interval])))", "legendFormat": "{{pgx_operation_type}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 23, "type": "timeseries", "title": "DB 错误率", "description": "错误/操作总量(比率)。旧盘画成了错误/秒,1 err/s 混在 10000 ops/s 里也飘红,已修", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 43, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "(sum (rate(db_client_operation_errors_total{service_name=\"$service\",db_system_name=\"postgresql\"}[$__rate_interval])) or sum (rate(db_client_operation_duration_seconds_count{service_name=\"$service\",db_system_name=\"postgresql\"}[$__rate_interval])) * 0) / sum (rate(db_client_operation_duration_seconds_count{service_name=\"$service\",db_system_name=\"postgresql\"}[$__rate_interval]))", "legendFormat": "错误率"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}, "overrides": []}}, {"id": 24, "type": "row", "title": "[$service] Redis(Dragonfly)—— P1:等 redisotel 发版;命中率需服务端指标(P2)", "gridPos": {"x": 0, "y": 51, "w": 24, "h": 1}, "collapsed": false}, {"id": 25, "type": "timeseries", "title": "命令 QPS by 操作", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 52, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (db_operation_name) (rate(db_client_operation_duration_seconds_count{service_name=\"$service\",db_system_name=\"redis\"}[$__rate_interval]))", "legendFormat": "{{db_operation_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 26, "type": "timeseries", "title": "命令 P99", "description": "Dragonfly 走 TLS(dragonfly.app.com:443),网络在这条曲线里 —— \n缓存比 DB 慢的话缓存就失去意义了,这条线应远低于 R5 的 query P95", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 6, "y": 52, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(db_client_operation_duration_seconds_bucket{service_name=\"$service\",db_system_name=\"redis\"}[$__rate_interval])))", "legendFormat": "P99"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 27, "type": "timeseries", "title": "连接池", "description": "pending 持续 >0 = 池不够或命令太慢(与 R5 空池等待同一逻辑)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 12, "y": 52, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "db_client_connection_count{service_name=\"$service\",db_system_name=\"redis\"}", "legendFormat": "{{state}}"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "db_client_connection_pending_requests{service_name=\"$service\",db_system_name=\"redis\"}", "legendFormat": "等待中"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 28, "type": "timeseries", "title": "Redis 客户端错误", "description": "经典联动:这里错误↑ 或超时↑,同时 R5 的 DB QPS↑ = 缓存击穿正在发生。\n命中率维度客户端埋点给不了,等 Dragonfly 服务端 /metrics(P2)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 18, "y": 52, "w": 6, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "(sum (rate(redis_client_errors_total{service_name=\"$service\"}[$__rate_interval])) or sum (rate(db_client_operation_duration_seconds_count{service_name=\"$service\",db_system_name=\"redis\"}[$__rate_interval])) * 0)", "legendFormat": "错误/s"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 29, "type": "row", "title": "网关入口(全局,不随 $service 变化)—— P1:等 gateway 发版", "gridPos": {"x": 0, "y": 60, "w": 24, "h": 1}, "collapsed": false}, {"id": 30, "type": "timeseries", "title": "入口 QPS by 状态段", "description": "用户视角的总入口。otelhttp 不带 URL 路径标签(高基数保护),按状态码看", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 61, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{http_response_status_code}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 31, "type": "timeseries", "title": "入口 5xx 比率", "description": "这里红了但 R1 各服务都绿 = 问题在网关自身(路由/鉴权/熔断),\n注意网关 tracing 曾把后端 5xx 记成 span OK(评审已列,metrics 口径不受影响)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 61, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "(sum (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or sum (rate(http_server_request_duration_seconds_count[$__rate_interval])) * 0) / sum (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "5xx 比率"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}, "overrides": []}}, {"id": 32, "type": "timeseries", "title": "入口延迟", "description": "与 R2 的服务端分位数的差值 ≈ 网关自身开销(鉴权/RBAC/路由)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 61, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "P95"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "P99"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 33, "type": "row", "title": "[$service] 出站 HTTP 依赖(ES / gorse / casdoor / 支付渠道等)", "gridPos": {"x": 0, "y": 69, "w": 24, "h": 1}, "collapsed": false}, {"id": 34, "type": "timeseries", "title": "出站 P95 by 目标", "description": "对标 ARMS「应用依赖服务」。server_address 是配置里的域名,有界。\n依赖不可用先于业务报错出现(OBSERVABILITY.md §3.3)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 70, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))", "legendFormat": "{{server_address}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 35, "type": "timeseries", "title": "出站 QPS by 目标", "description": "服务间不直调(经网关),所以这里只有外部依赖;真出现服务间 connect 直调时\n加 rpc_client_* 区块(otelconnect 客户端拦截器自动生效)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 12, "y": 70, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (server_address) (rate(http_client_request_duration_seconds_count{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "{{server_address}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}], "schemaVersion": 39, "editable": true}, "folderUid": "", "overwrite": true, "message": "generated: 应用 APM(RED + runtime + DB + Redis + 网关 + 出站依赖)"}
