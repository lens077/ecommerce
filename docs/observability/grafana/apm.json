"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "ms", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 5, "type": "table", "title": "服务侧错误率 Top(时间范围内)", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 9, "w": 12, "h": 6}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "instant": true, "format": "table", "expr": "topk(10, (sum by (service_name) (rate(rpc_server_duration_milliseconds_count{rpc_connect_rpc_error_code=~\"unknown|internal|unavailable|deadline_exceeded|resource_exhausted|data_loss|unimplemented\",service_name!=\"config-service\"}[$__rate_interval])) or sum by (service_name) (rate(rpc_server_duration_milliseconds_count{service_name!=\"config-service\"}[$__rate_interval])) * 0) / sum by (service_name) (rate(rpc_server_duration_milliseconds_count{service_name!=\"config-service\"}[$__rate_interval])))"}], "options": {"sortBy": [{"displayName": "Value", "desc": true}]}, "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": [{"matcher": {"id": "byRegexp", "options": "Time|le"}, "properties": [{"id": "custom.hidden", "value": true}]}]}}, {"id": 6, "type": "table", "title": "最慢方法 Top(P95,时间范围内)", "description": "从业务盘挪过来的:服务健康类面板统一归本盘,业务盘只留红绿灯", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 12, "y": 9, "w": 12, "h": 6}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "instant": true, "format": "table", "expr": "topk(10, histogram_quantile(0.95, sum by (le, service_name, rpc_method) (increase(rpc_server_duration_milliseconds_bucket{service_name!=\"config-service\"}[$__range]))))"}], "options": {"sortBy": [{"displayName": "Value", "desc": true}]}, "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": [{"matcher": {"id": "byRegexp"