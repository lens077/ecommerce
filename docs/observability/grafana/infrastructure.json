dPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "collapsed": false}, {"id": 9, "type": "timeseries", "title": "CPU 利用率", "description": "非 idle 时间占比,先按核汇总再对核取平均。直接 sum 会得到核数倍的数字", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 0, "y": 6, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "avg by (k8s_node_name) (sum by (k8s_node_name, cpu) (system_cpu_utilization_ratio{state!=\"idle\",k8s_node_name=~\"$node\"}))", "legendFormat": "{{k8s_node_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 10, "type": "timeseries", "title": "内存利用率", "description": "", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 8, "y": 6, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "system_memory_utilization_ratio{state=\"used\",k8s_node_name=~\"$node\"}", "legendFormat": "{{k8s_node_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 11, "type": "timeseries", "title": "内存构成", "description": "used / cached / buffered / slab。cached 高是正常的,不代表内存紧张", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 16, "y": 6, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "system_memory_usage_bytes{k8s_node_name=~\"$node\",state!=\"free\"}", "legendFormat": "{{k8s_node_name}} {{state}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []}}, {"id": 12, "type": "timeseries", "title": "文件系统使用率", "description": "仅 ext4/xfs,已排除 /var/lib/kubelet/** 的 PVC bind mount(那是每个带 PVC 的 Pod 一个挂载点,\n且底下还是同一块盘,重复统计)。改配置前写进 VM 的那批僵尸序列要等保留期过才会消失", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 0, "y": 14, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "system_filesystem_usage_bytes{state=\"used\",type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"} / ignoring(state) sum without(state) (system_filesystem_usage_bytes{type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"})", "legendFormat": "{{k8s_node_name}} {{mountpoint}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 13, "type": "timeseries", "title": "inode 使用率", "description": "磁盘还有空间但 inode 用尽也会写不进去,是容易被忽略的一类满盘", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 8, "y": 14, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "system_filesystem_inodes_usage{state=\"used\",type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"} / ignoring(state) sum without(state) (system_filesystem_inodes_usage{type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"})", "legendFormat": "{{k8s_node_name}} {{mountpoint}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}, "max": 1, "min": 0}, "overrides": []}}, {"id": 14, "type": "timeseries", "title": "磁盘吞吐", "description": "device 只取整盘 sd[a-z]。不过滤会把 sda 和 sda1..sda4 一起算进来,吞吐翻一倍", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 16, "y": 14, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "sum by (k8s_node_name, direction) (rate(system_disk_io_bytes_total{k8s_node_name=~\"$node\",device=~\"sd[a-z]\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 15, "type": "timeseries", "title": "磁盘 IO 等待队列", "description": "持续 >0 说明磁盘是瓶颈", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 0, "y": 22, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "sum by (k8s_node_name, device) (system_disk_pending_operations{k8s_node_name=~\"$node\",device=~\"sd[a-z]\"})", "legendFormat": "{{k8s_node_name}} {{device}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 16, "type": "timeseries", "title": "网络吞吐", "description": "device 已在采集侧限定为物理网卡(Cilium 的 lxc* veth 被排除,否则基数随 Pod 生命周期无限长)", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 8, "y": 22, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "sum by (k8s_node_name, direction) (rate(system_network_io_bytes_total{k8s_node_name=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 17, "type": "timeseries", "title": "网络错误与丢包", "description": "非零就该查。丢包常常比时延更早暴露网络问题", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 16, "y": 22, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "sum by (k8s_node_name, direction) (rate(system_network_errors_total{k8s_node_name=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}} 错误"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "sum by (k8s_node_name, direction) (rate(system_network_dropped_total{k8s_node_name=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}} 丢包"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "pps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 18, "type": "row", "title": "数据库依赖(pgxpool / otelpgx)", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1}, "collapsed": false}, {"id": 19, "type": "timeseries", "title": "连接池饱和度", "description": "acquired / max。原看板这里用的是 pgxpool_total_conns / pgxpool_acquired_conns,\n这两个指标名不存在(otelpgx 导出的是 *_connections),所以一直是空图。\n独立 config-center 已从本仓指标范围排除，其资源指标请到配置中心 System 页面查看", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 0, "y": 31, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "pgxpool_acquired_connections{service_name=~\"$service\",service_name!=\"config-service\"} / pgxpool_max_connections{service_name=~\"$service\",service_name!=\"config-service\"}", "legendFormat": "{{service_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 20, "type": "timeseries", "title": "连接池构成", "description": "", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 8, "y": 31, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "pgxpool_acquired_connections{service_name=~\"$service\",service_name!=\"config-service\"}", "legendFormat": "{{service_name}} 已占用"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "pgxpool_idle_connections{service_name=~\"$service\",service_name!=\"config-service\"}", "legendFormat": "{{service_name}} 空闲"}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "pgxpool_total_connections{service_name=~\"$service\",service_name!=\"config-service\"}", "legendFormat": "{{service_name}} 总数"}, {"refId": "D", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "pgxpool_max_connections{service_name=~\"$service\",service_name!=\"config-service\"}", "legendFormat": "{{service_name}} 上限"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 21, "type": "timeseries", "title": "空池等待", "description": "池子被抽空、请求只能排队的频率。这才是「池不够用」的真信号 —— \n光看 acquired 贴着 max 可能只是稳态,而这个一涨就是真的在等", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 16, "y": 31, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "sum by (service_name) (rate(pgxpool_empty_acquire_total{service_name=~\"$service\",service_name!=\"config-service\"}[$__rate_interval]))", "legendFormat": "{{service_name}} 次/秒"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 22, "type": "timeseries", "title": "空池平均等待时长", "description": "clamp_min 防零除:没有空池等待时分母为 0,不夹住会画出 +Inf", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 0, "y": 39, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "rate(pgxpool_empty_acquire_wait_time_nanoseconds_total{service_name=~\"$service\",service_name!=\"config-service\"}[$__rate_interval]) / clamp_min(rate(pgxpool_empty_acquire_total{service