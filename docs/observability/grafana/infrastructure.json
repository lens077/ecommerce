tilization_ratio))", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}}, "overrides": []}}, {"id": 3, "type": "stat", "title": "节点 CPU 最高", "description": "", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "max(avg by (k8s_node_name) (sum by (k8s_node_name, cpu) (system_cpu_utilization_ratio{state!=\"idle\"})))", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 4, "type": "stat", "title": "节点内存最高", "description": "", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "max(system_memory_utilization_ratio{state=\"used\"})", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 5, "type": "stat", "title": "节点磁盘最高", "description": "", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "P4169E866C3094E38"}, "expr": "m