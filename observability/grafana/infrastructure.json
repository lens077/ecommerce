{"dashboard": {"uid": "ecommerce-infrastructure", "title": "基础设施 · 节点与依赖", "tags": ["ecommerce", "infrastructure", "generated"], "timezone": "browser", "time": {"from": "now-6h", "to": "now"}, "refresh": "1m", "links": [{"type": "link", "title": "业务大盘", "icon": "apps", "url": "/d/ecommerce-overview/ecommerce-overview", "tooltip": "跳转到「业务大盘」(保持当前时间范围)", "keepTime": true, "targetBlank": false, "asDropdown": false, "includeVars": false, "tags": []}], "templating": {"list": [{"name": "node", "label": "节点", "type": "query", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "query": {"query": "label_values(system_cpu_utilization_ratio, k8s_node_name)", "refId": "v"}, "includeAll": true, "multi": true, "current": {"text": ["All"], "value": ["$__all"]}, "refresh": 2}, {"name": "service", "label": "服务", "type": "query", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "query": {"query": "label_values(pgxpool_max_connections, service_name)", "refId": "v"}, "includeAll": true, "multi": true, "current": {"text": ["All"], "value": ["$__all"]}, "refresh": 2}]}, "panels": [{"id": 1, "type": "row", "title": "概览", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false}, {"id": 2, "type": "stat", "title": "上报指标的节点数", "description": "集群共 3 个节点,但 node1 是 control-plane、collector DaemonSet 不调度过去,所以正常值是 2", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "count(count by (k8s_node_name) (system_cpu_utilization_ratio))", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}}, "overrides": []}}, {"id": 3, "type": "stat", "title": "节点 CPU 最高", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "max(avg by (k8s_node_name) (sum by (k8s_node_name, cpu) (system_cpu_utilization_ratio{state!=\"idle\"})))", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 4, "type": "stat", "title": "节点内存最高", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "max(system_memory_utilization_ratio{state=\"used\"})", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 5, "type": "stat", "title": "节点磁盘最高", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "max(system_filesystem_usage_bytes{state=\"used\",type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\"} / ignoring(state) sum without(state) (system_filesystem_usage_bytes{type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\"}))", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 6, "type": "stat", "title": "DB 连接池饱和度最高", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "max(pgxpool_acquired_connections / pgxpool_max_connections)", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 7, "type": "stat", "title": "在报指标的服务数", "description": "按 rpc_server_* 判活。只统计「近期有过调用」的服务,空闲服务不计入", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "count(count by (service_name) (rpc_server_duration_milliseconds_count))", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []}}, {"id": 8, "type": "row", "title": "节点资源(host_metrics)", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "collapsed": false}, {"id": 9, "type": "timeseries", "title": "CPU 利用率", "description": "非 idle 时间占比,先按核汇总再对核取平均。直接 sum 会得到核数倍的数字", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 6, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "avg by (k8s_node_name) (sum by (k8s_node_name, cpu) (system_cpu_utilization_ratio{state!=\"idle\",k8s_node_name=~\"$node\"}))", "legendFormat": "{{k8s_node_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 10, "type": "timeseries", "title": "内存利用率", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 6, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "system_memory_utilization_ratio{state=\"used\",k8s_node_name=~\"$node\"}", "legendFormat": "{{k8s_node_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 11, "type": "timeseries", "title": "内存构成", "description": "used / cached / buffered / slab。cached 高是正常的,不代表内存紧张", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 6, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "system_memory_usage_bytes{k8s_node_name=~\"$node\",state!=\"free\"}", "legendFormat": "{{k8s_node_name}} {{state}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []}}, {"id": 12, "type": "timeseries", "title": "文件系统使用率", "description": "仅 ext4/xfs,已排除 /var/lib/kubelet/** 的 PVC bind mount(那是每个带 PVC 的 Pod 一个挂载点,\n且底下还是同一块盘,重复统计)。改配置前写进 VM 的那批僵尸序列要等保留期过才会消失", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 14, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "system_filesystem_usage_bytes{state=\"used\",type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"} / ignoring(state) sum without(state) (system_filesystem_usage_bytes{type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"})", "legendFormat": "{{k8s_node_name}} {{mountpoint}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 13, "type": "timeseries", "title": "inode 使用率", "description": "磁盘还有空间但 inode 用尽也会写不进去,是容易被忽略的一类满盘", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 14, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "system_filesystem_inodes_usage{state=\"used\",type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"} / ignoring(state) sum without(state) (system_filesystem_inodes_usage{type=~\"ext4|xfs\",mountpoint!~\"/var/lib/kubelet/.*\",k8s_node_name=~\"$node\"})", "legendFormat": "{{k8s_node_name}} {{mountpoint}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}, "max": 1, "min": 0}, "overrides": []}}, {"id": 14, "type": "timeseries", "title": "磁盘吞吐", "description": "device 只取整盘 sd[a-z]。不过滤会把 sda 和 sda1..sda4 一起算进来,吞吐翻一倍", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 14, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (k8s_node_name, direction) (rate(system_disk_io_bytes_total{k8s_node_name=~\"$node\",device=~\"sd[a-z]\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 15, "type": "timeseries", "title": "磁盘 IO 等待队列", "description": "持续 >0 说明磁盘是瓶颈", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 22, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (k8s_node_name, device) (system_disk_pending_operations{k8s_node_name=~\"$node\",device=~\"sd[a-z]\"})", "legendFormat": "{{k8s_node_name}} {{device}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 16, "type": "timeseries", "title": "网络吞吐", "description": "device 已在采集侧限定为物理网卡(Cilium 的 lxc* veth 被排除,否则基数随 Pod 生命周期无限长)", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 22, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (k8s_node_name, direction) (rate(system_network_io_bytes_total{k8s_node_name=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 17, "type": "timeseries", "title": "网络错误与丢包", "description": "非零就该查。丢包常常比时延更早暴露网络问题", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 22, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (k8s_node_name, direction) (rate(system_network_errors_total{k8s_node_name=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}} 错误"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (k8s_node_name, direction) (rate(system_network_dropped_total{k8s_node_name=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{k8s_node_name}} {{direction}} 丢包"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "pps", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 18, "type": "row", "title": "数据库依赖(pgxpool / otelpgx)—— ⚠️ service_name=config-service 是两个程序的混合值,见 TODO", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1}, "collapsed": false}, {"id": 19, "type": "timeseries", "title": "连接池饱和度", "description": "acquired / max。原看板这里用的是 pgxpool_total_conns / pgxpool_acquired_conns,\n这两个指标名不存在(otelpgx 导出的是 *_connections),所以一直是空图。\n⚠️ service_name=config-service 这条曲线是**两个程序的混合值**:本仓\nbackend/services/config 与独立仓 config-center 服务名撞名、还连同一个 PG 池,\n连 db_client_connection_pool_name 都区分不开。撞名解决前这条不可信", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 31, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "pgxpool_acquired_connections{service_name=~\"$service\"} / pgxpool_max_connections{service_name=~\"$service\"}", "legendFormat": "{{service_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "thresholdsStyle": {"mode": "dashed"}}, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.9}]}}, "overrides": []}}, {"id": 20, "type": "timeseries", "title": "连接池构成", "description": "", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 31, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "pgxpool_acquired_connections{service_name=~\"$service\"}", "legendFormat": "{{service_name}} 已占用"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "pgxpool_idle_connections{service_name=~\"$service\"}", "legendFormat": "{{service_name}} 空闲"}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "pgxpool_total_connections{service_name=~\"$service\"}", "legendFormat": "{{service_name}} 总数"}, {"refId": "D", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "pgxpool_max_connections{service_name=~\"$service\"}", "legendFormat": "{{service_name}} 上限"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 21, "type": "timeseries", "title": "空池等待", "description": "池子被抽空、请求只能排队的频率。这才是「池不够用」的真信号 —— \n光看 acquired 贴着 max 可能只是稳态,而这个一涨就是真的在等", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 16, "y": 31, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "sum by (service_name) (rate(pgxpool_empty_acquire_total{service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service_name}} 次/秒"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 22, "type": "timeseries", "title": "空池平均等待时长", "description": "clamp_min 防零除:没有空池等待时分母为 0,不夹住会画出 +Inf", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 0, "y": 39, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "rate(pgxpool_empty_acquire_wait_time_nanoseconds_total{service_name=~\"$service\"}[$__rate_interval]) / clamp_min(rate(pgxpool_empty_acquire_total{service_name=~\"$service\"}[$__rate_interval]), 1)", "legendFormat": "{{service_name}}"}], "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "ns", "custom": {"lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true}}, "overrides": []}}, {"id": 23, "type": "timeseries", "title": "DB 操作 P95(分类型)", "description": "acquire / connect / prepare / query 四类分开看:acquire 慢是池不够,query 慢是 SQL 或库的问题,两者处置完全不同", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "gridPos": {"x": 8, "y": 39, "w": 8, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "cfqdfyp4nyq68f"}, "expr": "histogr