{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的能力集合。登录子窗口（label: auth）加载的是 Casdoor 的外部页面，刻意不授予任何权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://192.168.3.*:*" },
        { "url": "https://*.ecommerce.com" }
      ]
    }
  ]
}
