{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ecommerce Merchant",
  "identifier": "com.ecommerce.merchant",
  "build": {
    "beforeDevCommand": "pnpm --filter @ecommerce/merchant dev",
    "beforeBuildCommand": "pnpm --filter @ecommerce/merchant build",
    "devUrl": "http://localhost:3002",
    "frontendDist": "../../merchant/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "商家管理中心",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ]
  }
}
