{
  "include": ["src"],
  "exclude": ["src/routeTree.gen.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* 模块解析*/
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,   // locales/*.json
    "types": ["vite/client"],

    /* 现代工程化 */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,

    /* 路径别名 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ecommerce/api": ["../../packages/api/src/index.ts"],
      "@ecommerce/configs": ["../../packages/configs/src/index.ts"],
      "@ecommerce/constants": ["../../packages/constants/src/index.ts"],
      "@ecommerce/i18n": ["../../packages/i18n/src/index.ts"],
      "@ecommerce/types": ["../../packages/types/src/index.ts"],
      "@ecommerce/ui": ["../../packages/ui/src/index.ts"],
      "@ecommerce/utils": ["../../packages/utils/src/index.ts"]
    },

    /* 代码质量 */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  }
}
