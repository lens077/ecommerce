{
  "name": "ecommerce-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run -r test && vp run -r build",
    "hygiene": "knip && pnpm dedupe --check",
    "dev": "vp run consumer#dev",
    "dev:merchant": "vp run merchant#dev",
    "desktop": "pnpm --filter @ecommerce/desktop dev:consumer",
    "desktop:merchant": "pnpm --filter @ecommerce/desktop dev:merchant",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
