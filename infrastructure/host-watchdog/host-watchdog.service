[Unit]
Description=主机侧巡检(容器/systemd 单元/本机 HTTP/隧道站点/磁盘)
Documentation=https://github.com/lens077/ecommerce/blob/main/context/team/host-watchdog.md
# 不依赖 docker.service：WATCH 为空时可用于 dockerless 的 K8s 节点，只巡检 systemd/HTTP/磁盘。
# 2026-09-24 旧 node3 重装为 k3 后因这里硬依赖 Docker 而无法部署。
# 但保留 After=docker.service（只排序，不加 Wants/Requires）：没装 Docker 的主机上它不起作用；
# 装了 Docker 的主机若启动慢于 OnBootSec，巡检会等 dockerd 就绪，避免首轮把 WATCH 里
# 每个容器都记成 fail（2026-09-27 异构双审）。
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/host-watchdog
# 巡检发现问题时返回 1。那是「查出了问题」,不是「巡检本身坏了」——
# 不声明的话 systemd 会把每次发现问题都记成 failed,掩盖真正的脚本故障。
SuccessExitStatus=0 1
TimeoutStartSec=120
Nice=10
