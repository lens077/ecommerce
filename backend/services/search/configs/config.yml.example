server:
  addr: "0.0.0.0:30002"
  http:
    read_timeout: 10s
    write_timeout: 20s
    idle_timeout: 1m30s

data:
  database:
    postgres:
      host: localhost
      port: 5432
      user: postgres
      db_name: ecommerce

discovery:
  consul:
    addr: 127.0.0.1:8500
    scheme: http
    health_check: true

auth:
  casdoor:
    endpoint: "https://casdoor.example.com"

search:
  catalog:
    # 仅供本地进程配合 SSH 隧道使用；Kubernetes Pod 无法访问 node3 的回环监听。
    endpoint: "http://127.0.0.1:9200"
    api_key: "replace-with-search-only-api-key"
    index: ecommerce_catalog_products

log:
  framework:
    format: console
    log_level: debug
    error_level: error
  application:
    format: console
    level: debug
