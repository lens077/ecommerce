@cart_base_url = http://127.0.0.1:30006
@customer_id = 00000000-0000-4000-8000-000000000001
@merchant_id = 8966c1f2-fcc2-44bc-84f5-9de615ff235f
@spu_id = 5
@sku_id = 9

### Local health check
GET {{cart_base_url}}/healthz

### Read the full cart for the test customer
POST {{cart_base_url}}/cart.v1.CartService/GetCart
Content-Type: application/json
x-md-global-user-id: {{customer_id}}

{}

### Read only the cart badge count for the test customer
POST {{cart_base_url}}/cart.v1.CartService/GetCartSummary
Content-Type: application/json
x-md-global-user-id: {{customer_id}}

{}

### Add one item (mutates the development cart; run intentionally)
POST {{cart_base_url}}/cart.v1.CartService/AddProductToCart
Content-Type: application/json
x-md-global-user-id: {{customer_id}}

{
  "spuId": {{spu_id}},
  "skuId": {{sku_id}},
  "merchantId": "{{merchant_id}}",
  "quantity": 1,
  "selected": true,
  "spuName": "Cart SDK smoke-test product",
  "skuName": "Cart SDK smoke-test SKU",
  "price": 22.2,
  "skuAttributes": {
    "color": "test",
    "source": "ide-http-client"
  },
  "skuThumbnailUrl": "https://cdn.example.com/cart-sdk-smoke-test.jpg",
  "status": "CART_STATUS_ACTIVE"
}

### Change the test item quantity (mutates the development cart)
POST {{cart_base_url}}/cart.v1.CartService/UpdateCartItemQuantity
Content-Type: application/json
x-md-global-user-id: {{customer_id}}

{
  "spuId": {{spu_id}},
  "skuId": {{sku_id}},
  "merchantId": "{{merchant_id}}",
  "quantity": 2
}

### Remove the test item (mutates the development cart)
POST {{cart_base_url}}/cart.v1.CartService/RemoveCartItem
Content-Type: application/json
x-md-global-user-id: {{customer_id}}

{
  "spuIds": [{{spu_id}}],
  "skuIds": [{{sku_id}}],
  "merchantIds": ["{{merchant_id}}"],
  "status": ["CART_STATUS_ACTIVE"]
}
