# This selector must be mounted locally. It chooses where Cart loads its full
# Bootstrap document before Cart has any remote configuration available.
type: config_center
config_center:
  address: http://127.0.0.1:30010
  namespace: cart
  environment: dev
  key: bootstrap.yaml
  # Keep the actual token in the ignored source.dev.yaml or a Kubernetes Secret.
  service_token: ""
