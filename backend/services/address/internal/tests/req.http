### healthz
POST http://{{host}}:{{port}}/healthz
Content-Type: application/json

### k8s svc healthz
POST http://{{k8s_gateway_host}}:{{port}}/healthz
Content-Type: application/json

### ========== 网关接口测试 ==========

### 网关 - 创建地址
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/CreateAddress
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "recipient_name": "张三",
  "recipient_phone": "13800138000",
  "user_id": "88735c43-9899-44b6-9aec-74f37a8996b4",
  "detail": {
    "province": "上海市",
    "city": "上海市",
    "district": "浦东新区",
    "detail": "世纪大道100号",
    "postal_code": "200120",
    "full_text": "上海市上海市浦东新区世纪大道100号"
  },
  "is_default": true
}

### 网关 - 创建第二个地址（非默认）
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/CreateAddress
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "recipient_name": "李四",
  "recipient_phone": "13900139000",
  "user_id": "88735c43-9899-44b6-9aec-74f37a8996b4",
  "detail": {
    "province": "北京市",
    "city": "北京市",
    "district": "朝阳区",
    "detail": "建国路88号",
    "postal_code": "100022",
    "full_text": "北京市北京市朝阳区建国路88号"
  },
  "is_default": false
}

### 网关 - 获取地址详情
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/GetAddress
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "address_id": "{{address_id}}"
}

### 网关 - 获取地址列表
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/ListAddresses
Content-Type: application/json
Authorization: Bearer {{token}}

{}

### 网关 - 更新地址
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/UpdateAddress
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "address_id": "{{address_id}}",
  "recipient_name": {
    "value": "张三三"
  },
  "detail": {
    "province": "上海市",
    "city": "上海市",
    "district": "浦东新区",
    "detail": "世纪大道200号",
    "postal_code": "200120",
    "full_text": "上海市上海市浦东新区世纪大道200号"
  }
}

### 网关 - 设置默认地址
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/SetDefaultAddress
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "address_id": "{{address_id}}"
}

### 网关 - 删除地址
POST http://{{k8s_gateway_host}}:{{k8s_gateway_port}}/address.v1.AddressService/DeleteAddress
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "address_id": "{{address_id}}"
}

