server:
  addr: "0.0.0.0:30001"
  timeout: 10
  cors:
    allowed_origins:
      - http://localhost:3000

data:
  database:
    postgres:
      host: localhost
      port: 5432
      user: user
      password: password
      db_name: postgres
      tls:
        enable: true
        ssl_mode: "verify-ca"
        ca_pem: ""
      timezone: "Asia/Shanghai"
      pool:
        max_conns: 20
        min_conns: 5
        max_conn_lifetime: 3600
        max_conn_idle_time: 300
  cache:
    redis:
      host: localhost
      port: 443
      tls:
        enable: true
        insecure_skip_verify: true
        ca_pem: ""
      username: username
      password: password
      db: 0
      dial_timeout: 5
      read_timeout: 3
      write_timeout: 3
      pool_size: 10
      min_idle_conns: 5

log:
  framework:
    format: console
    log_level: debug
    error_level: error
  application:
    format: console
    level: debug

observability:
  enable: false
  trace:
    endpoint: localhost:4317
    tls:
      enable: false
      insecure_skip_verify: true
      ca_pem: ""
  metric:
    endpoint: localhost:4317
    tls:
      enable: false
      insecure_skip_verify: true
      ca_pem: ""
  log:
    endpoint: localhost:4318
    tls:
      enable: false
      insecure_skip_verify: true
      ca_pem: ""

discovery:
  consul:
    addr: localhost:8500
    health_check: true
    scheme: http
    ttl:
      duration: "30s"
      ping_interval_seconds: 1
    tls:
      enable: false
      insecure_skip_verify: true
      ca_pem: ""

kafka:
  brokers:
    - "192.168.3.120:9092"
  topic: "order-events"
  batch_size: 1
  batch_timeout_ms: 10
  async: true
