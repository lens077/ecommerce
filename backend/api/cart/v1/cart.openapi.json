    "/cart.v1.CartService/AddProductToCart": {
      "post": {
        "tags": [
          "cart.v1.CartService"
        ],
        "summary": "AddProductToCart",
        "description": "2026-08 移除 GetCartSummary(原「首页获取购物车数量」)。\n 它与 GetCart 是同一条 SQL 的两种投影:两者的 WHERE 逐字相同\n (user_id + status=active),而 GetCartSummary 的 COUNT(*) 恰好等于\n GetCartResponse.cart_item_quantity(data/cart.go 里就是 len(rows))——\n 即 GetCart 的响应本来就带着这个数字。前端徽标已改用 GetCart,\n 保留它只会让同一个数有两个来源,迟早对不上。\n proto3 无法对 rpc 名做 reserved,故以注释存档,不要再用这个名字。",
        "operationId": "cart.v1.CartService.AddProductToCart",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/cart.v1.AddProductToCartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cart.v1.AddProductToCartResponse"
                }
              }
            }
          }
        }
      }
    },
