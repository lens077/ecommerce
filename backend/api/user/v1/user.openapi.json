    "version": "0.1.0",
    "contact": {
      "name": "ecommerce"
    },
    "title": "user.v1"
  },
  "servers": [
    {
      "url": "https://gateway.apikv.com",
      "description": "公网网关（control-tower）。Gatus 用它做烟雾：`.../product.v1.ProductService/GetProductDetail`"
    },
    {
      "url": "http://localhost:8080",
      "description": "本地开发直连（VITE_GATEWAY_URL 的默认值）"
    }
  ],
  "paths": {
    "/user.v1.UserService/SignIn": {
      "post": {
        "tags": [
          "user.v1.UserService"
        ],
        "summary": "SignIn",
        "operationId": "user.v1.UserService.SignIn",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/user.v1.SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.SignInResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user.v1.UserService/UserProfile": {
      "post": {
        "tags": [
          "user.v1.UserService"
        ],
        "summary": "UserProfile",
        "operationId": "user.v1.UserService.UserProfile",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/user.v1.UserProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.UserProfileResponse"
                }
              }
            }
          }
        }
      }
    }
  },
