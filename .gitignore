.DS_Store
.idea
.vscode

# go test -coverprofile 的产物
coverage.out

# 仓库根的 node_modules（只装 commitlint + husky，见 package.json）
/node_modules

# pnpm 的内容寻址存储，装依赖时落在仓库里，不该入库
.pnpm-store/

backend/infrastructure/consul/consul-local-kv.json
backend/infrastructure/consul/consul-kv.json

# 个人 AI 协作备忘录（tmux 驱动 codex 的命令速查），不属于项目产物
helper.sh

# Impeccable 过程产物（截图/参考图/临时脚本/决策页/hook 缓存）；design.json 与 surfaces/ 入仓
.impeccable/shots/
.impeccable/refs/
.impeccable/questions/
.impeccable/*.mjs
**/.impeccable/hook.cache.json
.agent-teams/

# playwright-cli 的页面快照产物（带时间戳，每次运行都新增一份），不是项目产物
frontend/.playwright-cli/

# EdgeOne Pages 部署工具写的本地项目标识：仓库根与 frontend/ 各一份，每次部署都会重建，
# 内容只有 Name/ProjectId。入库的 frontend/edgeone.json 与 .github/workflows/edgeone-pages*.yml
# 是另一回事（部署配置与工作流，该跟仓库走）。
/.edgeone/
frontend/.edgeone/

# vite-plus 安装钩子时生成的分发器目录（`vp config` 写入，fresh clone 里不存在）。
# 显式忽略后 [PATH-REF] 才能在本机与 CI 上给出同一结论（2026-09-24）
frontend/.vite-hooks/_

# E2E 失败截图（frontend.yml 的 smoke-login 在 runner 上创建，本地跑也会落）
e2e-artifacts/

# TypeScript 增量编译缓存
*.tsbuildinfo

# Pangolin newt 隧道客户端二进制,本机工具,不进仓库
newt_linux_amd64
newt_*

# Python 字节码缓存（scripts/ 下的运维脚本）
__pycache__/
# Repowise 本地索引与隔离工具环境，不是仓库事实
.repowise/
tools/repowise/.venv/
# vitest/playwright 运行产物
frontend/test-results/

# 运行观测只作临时诊断，不成为新的环境文档或可搜索真相源。
.runtime/

# 安全审计报告只留本地、不进 Git：含公网 IP 字面量（verify-public-ips.py 会拦）
# 与集群/边缘细节；TODO.md 任务描述自含，不依赖报告也能读（2026-10-18 定）
SECURITY-AUDIT-*

# Tencent Cloud EdgeOne
.env
.edgeone/*
.tef_dist/*

# Agent 工作区记忆只留本地、不进 Git：含公网 IP 字面量与集群/边缘细节
# （verify-public-ips.py 扫跟踪+未忽略文件，会拦）；项目级共享内容走
# .workbuddy/skills/（2026-10-20 定，参照上方 SECURITY-AUDIT-* 同款理由）
.workbuddy/memory/
